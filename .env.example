# ─── Shuki configuration ────────────────────────────────────────────────
# Copy to `.env` and adjust. Values below work with `docker-compose.dev.yml`.

# Public URL under which Shuki is reachable (used for auth cookies/redirects).
# Local development (Vite dev server): http://localhost:5173
APP_URL=http://localhost:5173
PORT=3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# The first account always becomes admin. Set to false to close sign-ups afterwards.
ALLOW_REGISTRATION=true

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://shuki:shuki@localhost:5432/shuki

# ─── Object storage (S3-compatible) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shuki
S3_ACCESS_KEY_ID=shuki
S3_SECRET_ACCESS_KEY=shuki-secret
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=100

# ─── Worker ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
# Allow saving websites from private networks (intranet, localhost)
CLIPPER_ALLOW_PRIVATE_NETWORKS=false

# ─── Optional: AI provider (OpenAI-compatible API, e.g. OpenAI or Ollama) ─
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_CHAT_MODEL=llama3.1

LOG_LEVEL=info
