    "@shuki/db": "workspace:*",
    "@shuki/jobs": "workspace:*",
    "@shuki/storage": "workspace:*"
  },
  "devDependencies": {
    "@shuki/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "tsdown": "0.23.7",
    "tsx": "4.23.15"
  }
}
