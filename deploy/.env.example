# Shuki self-hosting configuration – copy to `.env` next to docker-compose.yml.

# Public URL of your instance (behind a reverse proxy: https://shuki.example.com)
APP_URL=http://localhost:3000
# Host port the app is published on
PORT=3000

# Required secrets – generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=shuki
S3_SECRET_ACCESS_KEY=

# The first account always becomes admin. Set to false to close sign-ups afterwards.
ALLOW_REGISTRATION=true

# External S3 instead of the bundled storage (also remove the `s3` service):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=shuki
# S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_MB=100
WORKER_CONCURRENCY=2

# Optional AI features (OpenAI-compatible API: OpenAI, Ollama, LM Studio, …)
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_CHAT_MODEL=llama3.1

# Pin a release instead of latest:
# SHUKI_IMAGE=ghcr.io/julian-schaefer/shuki:0.1.0
